<?xml version="1.0" encoding="utf-8"?>
<!-- ⚙️ Settings screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plum_night"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SmartPantry.Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/header_preferences" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartPantry.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchExpiryHighlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_highlight_expiring"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SmartPantry.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_highlight_expiring_summary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAlmostThere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/setting_almost_there"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SmartPantry.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_almost_there_summary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SmartPantry.Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/header_danger_zone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearPantry"
                style="@style/Widget.SmartPantry.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_clear_pantry" />

            <TextView
                style="@style/SmartPantry.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="casual"
                android:gravity="center"
                android:text="@string/about_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
