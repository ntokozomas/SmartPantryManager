<?xml version="1.0" encoding="utf-8"?>
<!-- 🧺 Pantry List screen -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plum_night">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_royal">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SmartPantry.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_pantry" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/textGreeting"
            style="@style/SmartPantry.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:text="@string/pantry_greeting" />

        <TextView
            android:id="@+id/textPantryCount"
            style="@style/SmartPantry.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonWhatCanICook"
            style="@style/Widget.SmartPantry.Button.Purple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/button_what_can_i_cook" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPantry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="96dp" />

            <TextView
                android:id="@+id/textEmptyPantry"
                style="@style/SmartPantry.Text.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/empty_pantry"
                android:textColor="@color/pink_soft"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:fontFamily="casual"
        android:text="@string/fab_add_item"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/pink_dark" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
