<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <!-- 🌸 Splash screen (launcher screen) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartPantry.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🧺 Pantry List -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- ✏️ Add / Edit Ingredient -->
        <activity
            android:name=".AddEditItemActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 🍳 Suggested Recipes -->
        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false" />

        <!-- 🧾 Recipe Detail -->
        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false" />

        <!-- 📖 Recipe Book -->
        <activity
            android:name=".RecipeBookActivity"
            android:exported="false" />

        <!-- ⚙️ Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
